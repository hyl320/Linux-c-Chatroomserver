# 编译生成的文件
*.o               # 编译过程中生成的目标文件
*.obj
*.so              # 动态链接库
*.a               # 静态链接库
*.lo
*.la
*.dll
*.exe
*.pdb
*.lib
*.exp
*.gch             # 预编译头文件

# CMake生成的文件
CMakeFiles/       # CMake生成的构建目录
CMakeCache.txt    # CMake缓存文件
Makefile          # Makefile文件
*.cmake           # CMake配置文件

# 编译生成的可执行文件
/build/           # 构建输出目录
/out/             # 编译后的输出文件夹

# IDE相关文件
.idea/            # JetBrains系列IDE (如IntelliJ IDEA, CLion)的项目文件
.vscode/          # VSCode的工作区文件
*.pro.user        # Qt Creator的项目设置文件

# 临时文件
*.swp             # Vim等编辑器产生的临时文件
*.swo
*.bak
*.tmp
*.log
*.~*              # 临时备份文件
*~                # 临时文件

# 编译器缓存和编译过程中产生的临时文件
*.cxx
*.d               # 依赖文件
*.dep             # 依赖文件

# 数据库文件
*.db              # SQLite等数据库文件

# 其他
*.user            # 用户相关配置文件
*.user.*
*.db
*.stackdump       # GCC/Clang生成的错误转储文件
